# Copy this file to `.env` and fill in any secrets you need.
# Local Postgres from `pnpm db:up` works with the default URL below.
#
# Hosted pre-prod / prod use separate Supabase projects and Vercel env vars.
# Never put hosted passwords in this file. Copy the pooler URI from
# Supabase → Project Settings → Database, then set it on Vercel:
#   POSTGRES_URL  (pre-prod: Preview + git branch `preprod`)
#   POSTGRES_URL  (prod: Production)
# Use the transaction pooler (:6543) for the Next.js app.

POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/discipline"

# Generate with: openssl rand -base64 32
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET="supersecret"

# Optional Google and Apple OAuth. Email/password works without these.
# @see https://www.better-auth.com/docs/authentication/google
AUTH_GOOGLE_ID="replace-me"
AUTH_GOOGLE_SECRET="replace-me"
# @see https://www.better-auth.com/docs/authentication/apple
AUTH_APPLE_ID="replace-me"
AUTH_APPLE_SECRET="replace-me"
AUTH_APPLE_APP_BUNDLE_IDENTIFIER="com.discipline.app"

# Public app origin used to build shareable invite links and Better Auth.
# Hosted: https://discipline-joo-chchs-projects.vercel.app (prod) or the `preprod` branch URL.
APP_URL="http://localhost:3000"
# Deep-link scheme for invite URLs. Use `discipline-preprod` on pre-prod.
APP_SCHEME="discipline"

# tRPC WebSocket (local only). Hosted Vercel deploys use HTTP `/api/trpc`.
# Leave these unset on Vercel / EAS release builds.
WS_PORT="3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
EXPO_PUBLIC_WS_URL="ws://localhost:3001"
# EXPO_PUBLIC_API_URL is set per EAS profile (preprod / production).

# Stripe — required to hold a stake. Never store PAN/CVC.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
