# Copy this file to `.env` and fill in any secrets you need.
# Local Postgres from `pnpm db:up` works with the default URL below.
# You can also point POSTGRES_URL at Supabase, Neon, or any other Postgres host.

POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/discipline"

# Generate with: openssl rand -base64 32
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET="supersecret"

# Optional Discord OAuth. Leave blank until you want sign-in.
# @see https://www.better-auth.com/docs/authentication/discord
AUTH_DISCORD_ID="replace-me"
AUTH_DISCORD_SECRET="replace-me"

# Optional Google and Apple OAuth for the login screen.
# @see https://www.better-auth.com/docs/authentication/google
AUTH_GOOGLE_ID="replace-me"
AUTH_GOOGLE_SECRET="replace-me"
# @see https://www.better-auth.com/docs/authentication/apple
AUTH_APPLE_ID="replace-me"
AUTH_APPLE_SECRET="replace-me"
AUTH_APPLE_APP_BUNDLE_IDENTIFIER="com.discipline.app"
